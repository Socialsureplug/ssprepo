# Copy to apps/api/.env (or export) — never commit real values.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://app:app@localhost:5432/payments_dev

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Long random string used to hash API keys, session tokens and reset tokens.
HASH_PEPPER=

WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:4000
CHECKOUT_URL=http://localhost:5173/pay
# COOKIE_DOMAIN=.example.com   # production: share session cookies across api./app. subdomains
TRUST_PROXY=0                  # set to the number of proxies in front of the API (e.g. 1 behind a load balancer)

# Email: console (dev), http (generic JSON email API), memory (tests)
EMAIL_PROVIDER=console
EMAIL_HTTP_ENDPOINT=
EMAIL_HTTP_API_KEY=
EMAIL_FROM="Nairaflow <no-reply@example.com>"
SUPPORT_EMAIL=support@example.com

# Dev only: allow merchant webhooks to http://localhost. Refused in production.
WEBHOOK_ALLOW_PRIVATE_URLS=false
LOG_LEVEL=info

# Seed script only (dev)
SEED_ADMIN_PASSWORD=
SEED_MERCHANT_PASSWORD=
SANDBOX_WEBHOOK_SECRET=
