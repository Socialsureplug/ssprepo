{
  "name": "nairaflow",
  "private": true,
  "version": "0.1.0",
  "description": "Bank-transfer payment infrastructure for modern businesses.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @app/api & npm run dev --workspace @app/web & npm run dev --workspace @app/admin",
    "dev:api": "npm run dev --workspace @app/api",
    "dev:worker": "npm run worker --workspace @app/api",
    "dev:web": "npm run dev --workspace @app/web",
    "dev:admin": "npm run dev --workspace @app/admin",
    "db:migrate": "npm run db:migrate --workspace @app/api",
    "db:seed": "npm run db:seed --workspace @app/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @app/api"
  },
  "engines": {
    "node": ">=20"
  }
}
